# Absolute or relative path to the unpacked Google Maps Scraper Chrome extension directory
# Example (Windows): EXTENSION_PATH=C:\path\to\google-maps-scraper-v2.6.0
# Example (macOS/Linux): EXTENSION_PATH=/path/to/google-maps-scraper-v2.6.0
EXTENSION_PATH=

# Browser channel: 'msedge' (recommended on Windows to avoid profile locks) or 'chrome'
CHROME_CHANNEL=msedge

# Extensions in Manifest V3 require headful browser mode
HEADLESS=false

# Port for the MCP Server HTTP listener (default: 3000)
PORT=3000

# Default timeout in milliseconds for scraping operations
BROWSER_TIMEOUT_MS=120000

# Optional: Playwright MCP Extension Token (only if using Playwright MCP extension bridge mode)
# Note: Keep this empty unless using Playwright MCP extension token bridge. Never commit tokens.
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
